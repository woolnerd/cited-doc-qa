# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# AI Service API Keys
GOOGLE_API_KEY=your-google-gemini-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
UPLOAD_RATE_LIMIT=10/hour
QUERY_RATE_LIMIT=30/hour

# Public Demo Mode Safeguards
# Keep disabled for normal local development. Enable for public demo deployments.
DEMO_MODE=false
DEMO_MAX_UPLOADS_PER_SESSION=3
DEMO_MAX_QUERIES_PER_SESSION=20
DEMO_MAX_TOTAL_UPLOAD_MB_PER_SESSION=25
DEMO_MAX_FILE_SIZE_MB=10
DEMO_MAX_QUERY_LENGTH=1000
DEMO_RATE_LIMIT_WINDOW_MINUTES=60
DEMO_MAX_QUERIES_PER_IP=30
DEMO_GLOBAL_DAILY_QUERY_LIMIT=250
DEMO_MAX_COMPLETION_TOKENS=1000
DEMO_MAX_RETRIEVED_CHUNKS=10
DEMO_REQUEST_TIMEOUT_SECONDS=45
DEMO_QUERY_ENHANCEMENT_TIMEOUT_SECONDS=5
DEMO_USAGE_HASH_SALT=

# Source document viewing (optional)
GCS_SOURCE_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=900
GOOGLE_APPLICATION_CREDENTIALS=

# Embedding and reranking providers
# Use openrouter in demo deployments to consolidate LLM, embeddings, and reranking.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-english-v3.0

# LLM Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
