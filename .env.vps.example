# VPS PostgreSQL Configuration
# Copy this to .env on your VPS at ~/production-rag-system/.env

# PostgreSQL Database (n8n postgres container)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE  # Use the password from setup script

# AI Service API Keys
# OpenRouter handles chat, embeddings, and reranking in this demo deployment.
OPENROUTER_API_KEY=your_openrouter_key_here
GOOGLE_API_KEY=optional_google_gemini_key
COHERE_API_KEY=optional_cohere_key

# Application Settings
APP_NAME=RAG Chatbot API
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS Settings (adjust for your frontend domain)
ALLOWED_ORIGINS=["https://rag.getfreetime.ai", "http://localhost:3000"]

# File Upload Settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=["pdf", "docx", "txt"]

# Rate Limiting
UPLOAD_RATE_LIMIT=10/hour
QUERY_RATE_LIMIT=30/hour
# Public Demo Mode Safeguards
# Enable for public demo deployments and use dedicated demo provider API keys.
DEMO_MODE=true
DEMO_MAX_UPLOADS_PER_SESSION=3
DEMO_MAX_QUERIES_PER_SESSION=20
DEMO_MAX_TOTAL_UPLOAD_MB_PER_SESSION=25
DEMO_MAX_FILE_SIZE_MB=10
DEMO_MAX_QUERY_LENGTH=1000
DEMO_RATE_LIMIT_WINDOW_MINUTES=60
DEMO_MAX_QUERIES_PER_IP=30
DEMO_GLOBAL_DAILY_QUERY_LIMIT=250
DEMO_MAX_COMPLETION_TOKENS=1000
DEMO_MAX_RETRIEVED_CHUNKS=10
DEMO_REQUEST_TIMEOUT_SECONDS=45
DEMO_QUERY_ENHANCEMENT_TIMEOUT_SECONDS=5
DEMO_USAGE_HASH_SALT=replace_with_random_demo_hash_salt

# Source document viewing
GCS_SOURCE_BUCKET=rag-demo-assets
GCS_SOURCE_PREFIX=real_docs
GCS_SIGNED_URL_TTL_SECONDS=900
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/rag-demo-gcs-viewer.json

# Embedding Configuration
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Chunking Configuration
CHUNK_SIZE_MIN=400
CHUNK_SIZE_MAX=600
CHUNK_SIZE_TARGET=500

# Search Configuration
SEARCH_TOP_K=10
SEARCH_SIMILARITY_THRESHOLD=0.45
VECTOR_SEARCH_LIMIT=30
FULL_TEXT_SEARCH_LIMIT=30
RERANK_TOP_K=5
RRF_K=60

# Reranking Configuration
RERANK_PROVIDER=openrouter
RERANK_MODEL=cohere/rerank-v3.5
RERANK_MAX_RETRIES=3
RERANK_RETRY_DELAY=1.0

# LLM Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
